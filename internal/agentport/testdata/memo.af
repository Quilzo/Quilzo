"{\n  \"agents\": [\n    {\n      \"name\": \"memo\",\n      \"agent_type\": \"letta_v1_agent\",\n      \"description\": \"Keeps notes for the team.\",\n      \"system\": \"<base_instructions>\\nYou are Memo, a note-keeping agent.\\n</base_instructions>\",\n      \"llm_config\": {\n        \"model\": \"gpt-4o-mini\",\n        \"model_endpoint_type\": \"openai\",\n        \"model_endpoint\": \"https://api.openai.com/v1\",\n        \"context_window\": 32000,\n        \"temperature\": 0.7\n      },\n      \"block_ids\": [\n        \"block-0\",\n        \"block-1\"\n      ],\n      \"tool_ids\": [\n        \"tool-0\",\n        \"tool-1\"\n      ],\n      \"tool_rules\": [\n        {\n          \"tool_name\": \"send_message\",\n          \"type\": \"exit_loop\"\n        }\n      ],\n      \"messages\": [\n        {\n          \"role\": \"user\",\n          \"content\": \"hi\"\n        },\n        {\n          \"role\": \"assistant\",\n          \"content\": \"hello\"\n        }\n      ],\n      \"source_ids\": [],\n      \"tags\": []\n    }\n  ],\n  \"groups\": [],\n  \"blocks\": [\n    {\n      \"id\": \"block-0\",\n      \"label\": \"persona\",\n      \"value\": \"I am Memo. I write short notes.\",\n      \"limit\": 5000\n    },\n    {\n      \"id\": \"block-1\",\n      \"label\": \"human\",\n      \"value\": \"The team works on the payments service.\",\n      \"limit\": 5000\n    }\n  ],\n  \"files\": [],\n  \"sources\": [],\n  \"tools\": [\n    {\n      \"id\": \"tool-0\",\n      \"name\": \"conversation_search\",\n      \"tool_type\": \"letta_core\",\n      \"description\": \"Search past conversation\"\n    },\n    {\n      \"id\": \"tool-1\",\n      \"name\": \"post_to_wiki\",\n      \"tool_type\": \"custom\",\n      \"description\": \"Post a note to the wiki\",\n      \"source_code\": \"def post_to_wiki(text): ...\"\n    }\n  ],\n  \"mcp_servers\": [],\n  \"metadata\": {},\n  \"created_at\": \"2026-01-01T00:00:00Z\"\n}"