{
  "$schema": "https://developer.microsoft.com/json-schemas/copilot/declarative-agent/v1.5/schema.json",
  "version": "v1.5",
  "name": "Repairs helper",
  "description": "Answers questions about repair tickets and the repair handbook.",
  "instructions": "You help field technicians. Look up tickets and cite the handbook section you used.",
  "capabilities": [
    {"name": "WebSearch", "sites": [{"url": "https://handbook.contoso.com/repairs"}, {"url": "https://status.contoso.com"}]},
    {"name": "OneDriveAndSharePoint", "items_by_url": [{"url": "https://contoso.sharepoint.com/sites/repairs"}]},
    {"name": "GraphConnectors", "connections": [{"connection_id": "repairsTickets"}]},
    {"name": "CodeInterpreter"}
  ],
  "conversation_starters": [{"title": "Open tickets", "text": "Which tickets are open?"}],
  "actions": [{"id": "repairsPlugin", "file": "ai-plugin.json"}],
  "behavior_overrides": {"special_instructions": {"discourage_model_knowledge": true}},
  "disclaimer": {"text": "Check the handbook before acting."}
}
