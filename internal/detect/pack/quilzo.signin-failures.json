{
  "id": "quilzo.signin-failures",
  "title": "Repeated failed sign-ins to Quilzo",
  "why": "somebody is guessing credentials for the admin or the API",
  "blind": "a slow guess that never crosses the failure threshold",
  "sources": [
    "quilzo/audit"
  ],
  "severity": 3,
  "when": {
    "match": {
      "field": "raw.action",
      "op": "equals",
      "values": [
        "auth.failures"
      ]
    }
  },
  "technique": [
    "T1110"
  ],
  "fixtures": [
    {
      "name": "the admin's threshold crossed",
      "match": true,
      "event": {
        "source": "quilzo/audit",
        "time": "2026-10-01T09:00:00Z",
        "received": "2026-10-01T09:00:05Z",
        "class": 6003,
        "disposition": 2,
        "actor": {
          "issuer": "quilzo",
          "value": "p_1a2b3c"
        },
        "message": "auth.failures",
        "raw": {
          "action": "auth.failures",
          "outcome": "denied",
          "resource": "/",
          "kind": "human",
          "surface": "admin",
          "failures": "6"
        }
      }
    },
    {
      "name": "an ordinary sign-in",
      "match": false,
      "event": {
        "source": "quilzo/audit",
        "time": "2026-10-01T09:00:00Z",
        "received": "2026-10-01T09:00:05Z",
        "class": 6003,
        "disposition": 1,
        "actor": {
          "issuer": "quilzo",
          "value": "p_1a2b3c"
        },
        "message": "signin.oidc",
        "raw": {
          "action": "signin.oidc",
          "outcome": "success",
          "resource": "/",
          "kind": "human"
        }
      }
    }
  ]
}
