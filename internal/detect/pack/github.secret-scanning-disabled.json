{
  "id": "github.secret-scanning-disabled",
  "title": "Secret scanning or push protection was switched off on GitHub",
  "why": "it is switched off before a secret is pushed, not after",
  "blind": "scanning never enabled in the first place",
  "sources": [
    "github/audit"
  ],
  "severity": 4,
  "when": {
    "match": {
      "field": "message",
      "op": "equals",
      "values": [
        "repository_secret_scanning.disable",
        "repository_secret_scanning_push_protection.disable"
      ]
    }
  },
  "technique": [
    "T1562"
  ],
  "fixtures": [
    {
      "name": "scanning disabled",
      "match": true,
      "event": {
        "source": "github/audit",
        "time": "2026-09-01T00:00:00Z",
        "received": "2026-09-01T00:00:05Z",
        "class": 6003,
        "disposition": 1,
        "actor": {
          "issuer": "github",
          "value": "dana-gh"
        },
        "message": "repository_secret_scanning.disable",
        "raw": {
          "action": "repository_secret_scanning.disable",
          "repo": "acme/shop",
          "org": "acme",
          "person": "dana@acme.com"
        }
      }
    },
    {
      "name": "push protection disabled",
      "match": true,
      "event": {
        "source": "github/audit",
        "time": "2026-09-01T00:00:00Z",
        "received": "2026-09-01T00:00:05Z",
        "class": 6003,
        "disposition": 1,
        "actor": {
          "issuer": "github",
          "value": "dana-gh"
        },
        "message": "repository_secret_scanning_push_protection.disable",
        "raw": {
          "action": "repository_secret_scanning_push_protection.disable",
          "repo": "acme/shop",
          "org": "acme",
          "person": "dana@acme.com"
        }
      }
    },
    {
      "name": "scanning enabled",
      "match": false,
      "event": {
        "source": "github/audit",
        "time": "2026-09-01T00:00:00Z",
        "received": "2026-09-01T00:00:05Z",
        "class": 6003,
        "disposition": 1,
        "actor": {
          "issuer": "github",
          "value": "dana-gh"
        },
        "message": "repository_secret_scanning.enable",
        "raw": {
          "action": "repository_secret_scanning.enable",
          "repo": "acme/shop",
          "org": "acme",
          "person": "dana@acme.com"
        }
      }
    }
  ]
