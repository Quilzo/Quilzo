{
  "id": "okta.policy-weakened",
  "title": "A sign-on or security policy was switched off or deleted in Okta",
  "why": "the rule that would have asked for a second factor is gone",
  "blind": "a policy edited to allow more while staying active",
  "sources": [
    "okta/system"
  ],
  "severity": 4,
  "when": {
    "match": {
      "field": "raw.eventType",
      "op": "equals",
      "values": [
        "policy.lifecycle.deactivate",
        "policy.lifecycle.delete",
        "policy.rule.deactivate",
        "policy.rule.delete"
      ]
    }
  },
  "technique": [
    "T1562"
  ],
