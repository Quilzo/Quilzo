# The published site: anonymous, the thing pointed at the internet.
#
# Separate from the admin because they have different exposures and different
# failure consequences. It holds no administrator's credential, which is why
# it needs no EnvironmentFile. The store is read-only to it except the paths
# below, which are its own state; on top of that it confines itself with
# Landlock to the same paths (docs/cms.md, "The three processes").
#
#   sudo -u quilzo quilzo --root /srv/quilzo/.quilzo site --prepare
#   sudo cp deploy/quilzo-site.service /etc/systemd/system/
#   sudo systemctl enable --now quilzo-site

[Unit]
Description=Quilzo public site
Documentation=https://github.com/Quilzo/Quilzo
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=quilzo
Group=quilzo
WorkingDirectory=/srv/quilzo

# The store is /srv/quilzo/.quilzo and the templates /srv/quilzo/templates.
ExecStart=/usr/local/bin/quilzo --root /srv/quilzo/.quilzo site \
  --templates /srv/quilzo/templates \
  --addr 127.0.0.1:8081 \
  --base-url https://example.com

Restart=on-failure
RestartSec=5s

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

# What the site writes, as `quilzo site --prepare` lists it: form submissions,
# boards, members, chatbot handoffs, analytics, bookings, the newsletter's
# list, the shield's state, its followers, the model ledger, webhook
# deliveries, its temporary directory, and the audit log's two files. Nothing
# else in the store, and not the store's root, where its policy, tokens and
# configuration are.
ReadWritePaths=/srv/quilzo/.quilzo/submissions /srv/quilzo/.quilzo/boards
ReadWritePaths=/srv/quilzo/.quilzo/members /srv/quilzo/.quilzo/handoff
ReadWritePaths=/srv/quilzo/.quilzo/analytics /srv/quilzo/.quilzo/shield
ReadWritePaths=/srv/quilzo/.quilzo/fediverse /srv/quilzo/.quilzo/usage
ReadWritePaths=/srv/quilzo/.quilzo/webhook-deliveries /srv/quilzo/.quilzo/tmp
# Added by upgrades, so marked with a leading -: until the store's owner runs
# quilzo site --prepare to make them, the unit starts without them and the
# site says what is off, rather than not starting at all.
ReadWritePaths=-/srv/quilzo/.quilzo/bookings -/srv/quilzo/.quilzo/newsletter
ReadWritePaths=/srv/quilzo/.quilzo/audit.jsonl /srv/quilzo/.quilzo/audit.jsonl.lock
