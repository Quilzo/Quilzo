# Copy to deploy/.env and set at least QUILZO_DOMAIN.

# The hostname the published site answers on. Point its DNS at this machine
# first: Caddy proves it controls the name to get the certificate.
# localhost works for a trial on one machine.
QUILZO_DOMAIN=example.com

# The ports the published site is on. Caddy listens and is published on
# these, and the site names the HTTPS one in its links whenever it is not
# 443. Change them for a trial beside something already on 80 and 443.
QUILZO_HTTP_PORT=80
QUILZO_HTTPS_PORT=443

# The image every Quilzo container runs: its tag here, and its name below.
# Both must be set, because compose.yaml names no default.
# No release is published yet, so there is no image to pull: these name the
# one deploy/README.md builds from this checkout before anything runs it. To
# change what runs, build it again and `docker compose up -d`.
#
# Once there is a release, name its image by the digest you checked
# (INSTALL), so the stack runs that image and no other:
#   QUILZO_VERSION=1.2.3@sha256:...
#   QUILZO_IMAGE=ghcr.io/quilzo/quilzo
# and leave out the `docker build` step in deploy/README.md, which would
# build main under the release's name. A tag alone, latest above all, is
# whatever was pushed under it last.
QUILZO_VERSION=local

# Whose image: a name of its own for one built here, so it is never taken
# for the release's.
QUILZO_IMAGE=quilzo

# The port the admin has on this machine's loopback, over HTTPS:
# https://localhost:8443 by default.
QUILZO_ADMIN_PORT=8443

# The network Caddy and the site share, and Caddy's address on it: the one
# address the site believes a forwarded client address from. Move both, the
# address inside the range, if this machine already uses the range.
QUILZO_EDGE_SUBNET=172.31.250.0/28
QUILZO_PROXY_ADDRESS=172.31.250.10
