# Copy to deploy/.env and set at least QUILZO_DOMAIN.

# The hostname the published site answers on. Point its DNS at this machine
# first: Caddy proves it controls the name to get the certificate.
# localhost works for a trial on one machine.
QUILZO_DOMAIN=example.com

# Which release to run. latest follows releases; a version (0.3.0) stays put
# until you change it here and run `docker compose pull && docker compose up -d`.
QUILZO_VERSION=latest

# Whose image. The release's, unless you built one (deploy/README.md says
# how); then its name here, and its tag as QUILZO_VERSION.
QUILZO_IMAGE=ghcr.io/quilzo/quilzo

# The port the admin has on this machine's loopback.
QUILZO_ADMIN_PORT=8080
