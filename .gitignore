# Build output
bin/
# Anchored to the root, because the binary and the command's source directory
# now share a name. An unanchored `quilzo` matches any path segment, so it
# swallowed cmd/quilzo/ — git silently refused to add 48 source files, and a
# commit that deleted cmd/scrivet/ without adding its replacement looked
# perfectly normal in `git status`.
/quilzo
*.exe

# A store, which is data and not source. `quilzo init` makes one in the
# working directory, so this is the file every contributor would otherwise
# commit on their first run.
.quilzo/

# What a running site writes beside its store.
templates/
export/
*.log

# Python packaging left over from an earlier life. Named rather than covered by
# a pattern, because the file that got committed declared a different licence
# from the one this project ships under and nobody noticed for months.
*.egg-info/
__pycache__/
